# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 3D source assets — only the exported GLBs ship; .blend files stay local
/art/
*.blend
*.blend1

# Mobile (Expo) — Phase 2 work stream 5. See docs/19-mobile-app.md.
mobile/node_modules/
mobile/.expo/
mobile/.expo-shared/
mobile/dist/
mobile/web-build/
mobile/ios/Pods/
mobile/ios/build/
mobile/android/build/
mobile/android/app/build/
mobile/android/.gradle/
mobile/.env*
!mobile/.env.example
# Play Store service-account key — never commit. Rename if you put
# it elsewhere; this catches the recommended location from
# mobile/eas.json.
mobile/play-store-key.json

# local agent/editor + runtime artifacts
.claude/
.recovery/
dev.log
