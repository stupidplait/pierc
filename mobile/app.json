{
  "expo": {
    "name": "Pierc Studio",
    "slug": "pierc-studio",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pierc",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "studio.pierc.app",
      "associatedDomains": ["applinks:piercing.studio"],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Доступ к фото нужен, чтобы примерить украшения на ваше селфи прямо в браузере.",
        "NSCameraUsageDescription": "Камера нужна, если вы хотите сделать селфи прямо в приложении для примерки украшений.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "studio.pierc.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "piercing.studio" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
