{
  "expo": {
    "name": "PIERCERKZN",
    "slug": "pierc-studio",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pierc",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0908",
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0a0908"
    },
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0a0908"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "studio.pierc.app",
      "associatedDomains": [
        "applinks:piercing.studio"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Доступ к фото нужен, чтобы примерить украшения на ваше селфи прямо в браузере.",
        "NSCameraUsageDescription": "Камера нужна, если вы хотите сделать селфи прямо в приложении для примерки украшений.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "studio.pierc.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0a0908"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "piercing.studio"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "861687ba-c4c0-4afa-a881-062e01928596"
      }
    },
    "owner": "plait",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/861687ba-c4c0-4afa-a881-062e01928596"
    }
  }
}
