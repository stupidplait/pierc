# 3D Piercing Studio — environment variables.
# Copy this file to `.env.local` (for local dev) and fill in real values.
# Never commit `.env.local`. See docs/03-architecture.md for the full reference.

# ───── Database (Neon Postgres) ─────
# Pooled connection used at runtime by the Prisma client. On Vercel serverless,
# point this at Neon's POOLED endpoint and cap per-instance connections so a burst
# of concurrent functions can't exhaust Neon's connection ceiling, e.g.:
#   postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/db?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL=""
# Direct (non-pooled) connection used by Prisma migrations (`prisma migrate dev`,
# `prisma migrate deploy`). Must be the NON-pooled endpoint.
DIRECT_URL=""

# ───── File storage (Vercel Blob) ─────
BLOB_READ_WRITE_TOKEN=""

# ───── Auth (Auth.js) ─────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Set to "true" for local dev and non-Vercel deploys so NextAuth
# trusts the request host. Not needed on Vercel.
AUTH_TRUST_HOST="true"

# ───── Email (Resend) ─────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="studio@example.com"

# ───── Telegram bot (admin alerts + user account-linking) ─────
# The admin's chat id is stored in the DB Settings row, not here.
TELEGRAM_BOT_TOKEN=""
# Optional: the bot's @username. If unset it's resolved once via getMe.
# Needed to build the t.me/<bot>?start=… connect deep-link on /account.
TELEGRAM_BOT_USERNAME=""
# Secret echoed back by Telegram in the X-Telegram-Bot-Api-Secret-Token
# header; the /api/telegram/webhook route rejects requests without it.
# Register the webhook with: npx tsx -r dotenv/config scripts/set-telegram-webhook.ts
TELEGRAM_WEBHOOK_SECRET=""

# ───── Public app URL (for deep-links inside emails / Telegram) ─────
# In dev, leave empty (links will be relative). On Vercel set this to
# the deployment URL, e.g. APP_URL="https://piercing.studio".
APP_URL=""

# ───── Vercel Cron (auto-3D job polling) ─────
# Generate a long random string. Vercel Cron is configured in vercel.json
# to hit /api/cron/poll-jobs once daily (09:00 UTC — see vercel.json crons);
# the route refuses requests whose Authorization header isn't
# `Bearer ${CRON_SECRET}`. When unset outside production the route is open so
# you can curl it locally; in production a missing secret now fails closed.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET=""

# ───── Observability (optional) ─────
# When set, warn/error events are best-effort POSTed here as JSON (a Slack/Discord
# incoming webhook, your own relay, or a Sentry relay). Unset → errors are still
# logged to stdout/stderr (captured by Vercel's log drains) but not forwarded.
# Wired through lib/observability/logger.ts; client errors arrive via /api/monitoring.
MONITORING_WEBHOOK_URL=""

# ───── 3D generation ─────
# Replicate — managed-inference provider (NEW PRIMARY). Get an API token
# at https://replicate.com/account/api-tokens. Roughly 10–50× cheaper per
# generation than Tripo3D at this scale (~$0.01–0.05 vs $0.20–2.00).
# See docs/18-replicate-3d.md for the full setup.
REPLICATE_API_TOKEN=""
# Replicate model spec. Three accepted formats:
#   • <hash>                       — bare 64-hex version hash
#   • <owner>/<name>:<hash>        — slug + version (recommended; pin)
#   • <owner>/<name>               — slug only (uses model's latest)
# Default suggestion: Hunyuan3D-2 (Tencent). Find current versions at
# https://replicate.com/tencent/hunyuan3d-2 and pin a hash for stability.
REPLICATE_MODEL=""

# Tripo3D — auto-generation fallback (was the primary before Replicate).
# Kept in the chain so an unconfigured Replicate or API outage doesn't
# break the auto-3D button. Get an API key at https://platform.tripo3d.ai.
# The manual .glb upload path stays free regardless.
TRIPO3D_API_KEY=""

# Set to "1" to short-circuit the auto-3D pipeline: no real API call, no
# charges. The button creates a dummy job that polls "succeeded" using a
# public Khronos sample GLB. Useful for testing the full UI flow
# (generate -> poll -> approve -> showroom render) without burning credits.
# Leave unset (or "0") in production.
DRY_RUN_3D_GEN=""

# Gemini vision — OPTIONAL AI correction for auto-generated models. Two uses, both
# free-tier and both no-op gracefully when this key is unset:
#   1) Roll/head tiebreaker — geometry recovers a piece's axis/attach/scale, but the
#      roll ("which way is up") on an asymmetric face is semantic; the pipeline renders
#      candidate rotations and asks Gemini which matches the product photo
#      (lib/admin/glb-roll-vision.ts).
#   2) Quality gate — renders the finished mesh from several angles and asks Gemini
#      whether it's a faithful, clean reconstruction; a confident reject auto-retries
#      the next provider, so the admin review queue only ever sees good models
#      (lib/admin/glb-quality-vision.ts).
# Get a key at https://aistudio.google.com/apikey. Unset → both steps are skipped and
# everything else works unchanged.
# PRIVACY: the FREE tier may use submitted images to improve Google's products.
# Reference jewelry photos are low-sensitivity product shots, so this is normally fine;
# switch to a paid Gemini key (fractions of a cent per call) to opt out of training.
GEMINI_API_KEY=""

# Local self-hosted generation — the credit-zero fallback (see
# docs/22-local-fallback.md). When "1", the `local` provider joins the tail
# of the auto chain (replicate -> tripo3d -> local), so a generation falls
# through to your own hardware once the paid providers are exhausted.
#
# The server side (provider + claim/result endpoints) is now built; only the GPU
# worker script that calls them is left to run (see docs/22-local-fallback.md).
# Flip to "1" only once that worker is running, otherwise generations fall through
# to a job that just sits PROCESSING until a worker claims it.
LOCAL_3D_WORKER=""

# Bearer secret the pull-worker presents to POST /api/local-jobs/claim and
# /api/local-jobs/[id]/result. REQUIRED for those endpoints — they fail closed
# (reject every request) when this is unset. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOCAL_WORKER_SECRET=""

# ───── Local tooling (scripts only — never used at runtime) ─────
# Path to a Blender executable for the mesh-anchor sync script
# (`npm run anchors:sync`). Optional — the script also scans common install
# locations. Not needed in production or by the deployed app.
BLENDER_EXE=""

# ───── One-time admin seed ─────
# Used by prisma/seed.ts (added in Task 3) to create the initial admin user.
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="change-me"

# ───── Mobile app — Universal Links / App Links ─────
# Required only when the iOS / Android app has actually been built and
# you want https://piercing.studio/<path> links to open in the native app
# instead of Safari/Chrome. See docs/19-mobile-app.md and mobile/README.md.
#
# Apple Universal Links: served at /.well-known/apple-app-site-association.
# Without APPLE_TEAM_ID set, that route returns 404 (cleaner than a broken
# manifest with placeholder values).
APPLE_TEAM_ID=""
APPLE_BUNDLE_ID="studio.pierc.app"
#
# Android App Links: served at /.well-known/assetlinks.json. Find the
# SHA-256 fingerprint via `eas credentials` (managed flow) or
# `keytool -list -v -keystore release.keystore` (manual). Comma-separated
# if you list multiple (e.g., upload key + Play Store signing key).
ANDROID_SHA256_FINGERPRINT=""
ANDROID_PACKAGE_NAME="studio.pierc.app"
