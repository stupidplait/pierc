// Prisma schema — Tasks 1+4 subset.
// Future tasks will add catalog/booking/3D-pipeline models per docs/04-data-model.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───── Auth ─────

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  phone           String?
  // Telegram @username the customer typed in — for manual contact.
  telegram        String?
  // Linked Telegram chat id (set when the user connects via the bot deep-link)
  // — used to send them booking confirmations / status updates automatically.
  telegramChatId  String?
  name            String
  passwordHash    String? // null for guest
  isGuest         Boolean          @default(true)
  createdAt       DateTime         @default(now())
  appointments    Appointment[]
  jewelryBookings JewelryBooking[]
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

// ───── 3D anchors & body ─────

enum BodyPlace {
  EAR // мочка, хеликс, козелок, конха, дейс, рук, индастриал
  NOSE // ноздри, септум
  LIPS // медуза, лабрет
  EYEBROW // бровь
  TONGUE // язык
  NIPPLE // сосок
  NAVEL // пупок
  HIP // бедро
  ANKLE // лодыжка
}

enum AnchorSide {
  L
  R
  CENTER
}

model AnchorPoint {
  id              String                 @id @default(cuid())
  slug            String                 @unique
  name            String
  place           BodyPlace
  side            AnchorSide             @default(CENTER)
  // { x, y, z } in body.glb local space (Y-up)
  position        Json
  // { x, y, z } default jewelry orientation (Euler XYZ rad). Aims a piece's
  // canonical +Z at the skin's outward normal — correct for posts/studs.
  rotation        Json
  // { x, y, z } RING-family orientation override (Euler XYZ rad). A hoop must
  // hang + face the viewer, which the post `rotation` gets wrong on laterally-
  // facing anchors (ear/hip/ankle). Null → renderer derives a hoop frame from
  // `rotation` (deriveRingRotation in lib/catalog/place-jewelry.ts).
  ringRotation    Json?
  // How a hoop (RING) seats here:
  //   "dangle" (default) — hangs from the band-top, front-facing (lobes, navel).
  //   "captive" — CENTERED on the piercing, wrapping the rim, facing the camera
  //     (ear cartilage). Without it a cartilage hoop dangles INTO the pinna and is
  //     occluded — only its top arc shows. See lib/catalog/place-jewelry.ts.
  hoopSeat        String                 @default("dangle")
  // [{ name, position, target, fov }, ...]
  cameraPresets   Json
  // Replaces the old implicit M2M to Jewelry. See JewelryAnchorBinding
  // for the multi-anchor pricing/rendering model — a single barbell is
  // 2 rows here, an "industrial-left" jewelry occupies forward-helix-L
  // (order=0) and posterior-helix-L (order=1) of the same piece.
  jewelryBindings JewelryAnchorBinding[]
  createdAt       DateTime               @default(now())
}

// ───── Catalog ─────

enum JewelryStatus {
  DRAFT
  PROCESSING
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

// Drives binding-count rules and renderer math. See docs/20-multi-anchor-jewelry.md
// for the canonical mapping from real-world piece → enum value.
//
//   STUD              — 1 attach point per equip (labret, nose stud, plug). The
//                       jewelry's anchorBindings list is a "compatibility list"
//                       — each row is an alternative anchor the user could equip
//                       this piece to, all with order=0.
//   RING              — 1 attach point per equip (hoop / seamless ring through 1 hole).
//                       Same compatibility-list semantics as STUD.
//   BARBELL           — 2 attach points equipped together (industrial bar, surface bar).
//                       anchorBindings has exactly 2 rows: order=0 = "in" / forward end,
//                       order=1 = "out" / posterior end. Bindings are FIXED; left-side
//                       industrial and right-side industrial are separate Jewelry rows.
//   CIRCULAR_BARBELL  — 2 attach points (horseshoe used through 2 holes).
//   ORBITAL           — 2 attach points (closed ring through 2 holes on the same cartilage).
//   CHAIN_LADDER      — N attach points (corset). 2..8 bindings.
enum JewelryType {
  STUD
  RING
  BARBELL
  CIRCULAR_BARBELL
  ORBITAL
  CHAIN_LADDER
}

model JewelryCategory {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  order     Int       @default(0)
  jewelries Jewelry[]
}

model Jewelry {
  id          String          @id @default(cuid())
  // Stable slug used by the parametric jewelry seed pipeline
  // (`prisma/seed-data/jewelry.json`) for idempotent upsert. Nullable so
  // admin-created pieces don't need one. Unique when present so re-running
  // the seed never produces duplicates.
  slug        String?         @unique
  name        String
  description String?
  category    JewelryCategory @relation(fields: [categoryId], references: [id])
  categoryId  String
  // Drives renderer math (1-anchor vs multi-anchor placement) and admin
  // form constraints (e.g. AI generation is restricted to STUD/RING).
  // See enum docs above and docs/20-multi-anchor-jewelry.md.
  type        JewelryType     @default(STUD)
  material    String
  gauge       Float?
  size        Float?
  color       String?
  stones      String?
  price       Decimal         @db.Decimal(10, 2)
  inStock     Int             @default(0)
  // [{ url: string, alt: string }]
  photos      Json            @default("[]")
  glbUrl      String?
  // Per-piece render-time scale multiplier in `EquippedPieces.JewelryGLB`.
  // Defaults to 1.0 — the parametric Blender pipeline exports models in
  // real-world meters, so they need no scaling. Tripo3D-generated models
  // arrive at unknown scale and can use this field to compensate
  // (historically `0.025` was hardcoded in the renderer).
  glbScale    Float           @default(1)
  glbThumbUrl String?
  // Transparent-background PNG used as a 2D sprite in the photo-upload
  // "lite mode" try-on (see docs/15-lite-mode.md). When null, the piece is
  // hidden from the lite-mode try-on list but still appears in the
  // "Все украшения" grid view.
  spriteUrl   String?
  status      JewelryStatus   @default(DRAFT)
  featured    Boolean         @default(false)
  // Replaces the old implicit M2M `anchors AnchorPoint[]`. For STUD/RING:
  // each row is one alternative anchor the user can equip the piece on,
  // all with order=0. For BARBELL/CIRCULAR_BARBELL/ORBITAL/CHAIN_LADDER:
  // exactly the bindings the piece occupies, in attach order.
  anchorBindings JewelryAnchorBinding[]
  jobs        GenerationJob[]
  bookings    JewelryBooking[]
  reviews     Review[]        @relation("JewelryReviews")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([featured])
  @@index([type])
}

// Explicit junction table replacing the old implicit `_JewelryAnchors` M2M.
// One row per (jewelry, anchor, order) — `order` is the attach-point index
// within the jewelry's mesh:
//
//   order=0 → mesh's `attach:primary` empty
//   order=1 → mesh's `attach:secondary` empty
//   order=2..N → `attach:tertiary`, `attach:quaternary`, … (CHAIN_LADDER)
//
// Semantics differ by Jewelry.type:
//   STUD / RING                  : every row is an independent compatibility option;
//                                  the user equips the piece on ONE of them at a time.
//                                  (i.e. 6 rows = "this piece can be worn at 6 anchors".)
//   BARBELL / CIRCULAR_BARBELL /
//   ORBITAL / CHAIN_LADDER       : ALL rows are equipped simultaneously; the user
//                                  picks the piece (not the anchor) and both/all
//                                  endpoints attach together.
//
// See docs/20-multi-anchor-jewelry.md for the renderer math + UX rules.
model JewelryAnchorBinding {
  id        String      @id @default(cuid())
  jewelry   Jewelry     @relation(fields: [jewelryId], references: [id], onDelete: Cascade)
  jewelryId String
  anchor    AnchorPoint @relation(fields: [anchorId], references: [id])
  anchorId  String
  // 0-indexed position within the jewelry's bindings. For STUD/RING all
  // rows have order=0; for multi-anchor types, order distinguishes
  // attach:primary (0), attach:secondary (1), etc.
  order     Int         @default(0)
  // { x, y, z } per-(piece × anchor) local orientation nudge (Euler XYZ rad):
  // z = roll about the hole-axis, y = yaw, x = pitch. Admin escape hatch from
  // the review screen for asymmetric hoops / artistic tuning. Null → none.
  // Lives on the binding (not the GLB) so one piece can sit right on many
  // anchors. See place-jewelry.ts orientationForPiece().
  rotationOffset Json?
  createdAt DateTime    @default(now())

  @@unique([jewelryId, anchorId, order])
  @@index([jewelryId])
  @@index([anchorId])
}

// ───── 3D generation pipeline ─────

enum GenerationJobStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

// One row per attempted auto-3D generation. Manual .glb uploads bypass this
// table entirely (they write straight to Jewelry.glbUrl). The pipeline:
//   QUEUED -> PROCESSING -> (SUCCEEDED with resultGlbUrl) | FAILED
model GenerationJob {
  id            String              @id @default(cuid())
  jewelry       Jewelry             @relation(fields: [jewelryId], references: [id], onDelete: Cascade)
  jewelryId     String
  // "tripo3d" | "manual" — adapter that should poll/own this job.
  provider      String
  // External provider's id; null for synchronous providers like manual.
  providerJobId String?
  status        GenerationJobStatus @default(QUEUED)
  // [{ url, alt }] — snapshot of jewelry.photos at job-creation time.
  inputPhotos   Json                @default("[]")
  // Populated on SUCCEEDED, copied onto Jewelry.glbUrl on admin approval.
  resultGlbUrl  String?
  // Populated on FAILED.
  errorMessage  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  startedAt     DateTime?
  completedAt   DateTime?

  @@index([jewelryId])
  @@index([status])
}

// ───── Booking — slots, appointments, jewelry bookings ─────

// One bookable time slot. `appointment` is 1:1 (a slot can hold at most one
// appointment); the @unique constraint on Appointment.slotId is what enforces
// that. `isOpen` lets the admin temporarily hide a slot from the public picker
// without deleting (e.g. holiday).
model AvailabilitySlot {
  id          String       @id @default(cuid())
  startsAt    DateTime
  endsAt      DateTime
  isOpen      Boolean      @default(true)
  appointment Appointment?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Composite covers both the getOpenSlots startsAt filter (leading-column
  // prefix) and the createSlot/bulkCreateSlots `startsAt < end AND endsAt >
  // start` range scan. A DB-level overlap EXCLUDE constraint is added out of
  // band (see prisma/sql/001_slot_overlap_exclusion.sql + `npm run db:constraints`).
  @@index([startsAt, endsAt])
  @@index([isOpen])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// An admin-confirmable visit. May be jewelry-only (slotId=null) when the user
// only reserved jewelry without booking a piercing session, or full
// (slot + bookings) for the combined flow. `bookings` is many — one
// appointment can carry several jewelries.
model Appointment {
  id        String            @id @default(cuid())
  user      User              @relation(fields: [userId], references: [id])
  userId    String
  slot      AvailabilitySlot? @relation(fields: [slotId], references: [id])
  slotId    String?           @unique
  // The piercing service booked for this visit. Optional so legacy
  // appointments (and the rare no-service consult) remain valid.
  service   Service?          @relation(fields: [serviceId], references: [id])
  serviceId String?
  status    AppointmentStatus @default(PENDING)
  notes     String?
  // Snapshot of the booked slot's start time, captured when the slot is
  // released (e.g. on cancellation, which nulls slotId to free the slot for
  // rebooking). Lets the account UI still show *when* a cancelled visit was
  // for, instead of losing the date with the slot link.
  scheduledAt DateTime?
  bookings  JewelryBooking[]
  reviews   Review[]
  // Set when a magic-link review submission succeeds for this
  // appointment. One-shot — see docs/16-reviews.md.
  reviewedAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@index([slotId])
  @@index([serviceId])
}

enum JewelryBookingStatus {
  RESERVED
  CONFIRMED
  FULFILLED
  CANCELLED
}

// One row per chosen jewelry per booking (multi-piece flows produce many of
// these per Appointment). Stock is decremented at creation; cancellation
// restores it.
model JewelryBooking {
  id            String               @id @default(cuid())
  jewelry       Jewelry              @relation(fields: [jewelryId], references: [id])
  jewelryId     String
  user          User                 @relation(fields: [userId], references: [id])
  userId        String
  appointment   Appointment?         @relation(fields: [appointmentId], references: [id])
  appointmentId String?
  quantity      Int                  @default(1)
  status        JewelryBookingStatus @default(RESERVED)
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([jewelryId])
  @@index([userId])
  @@index([appointmentId])
  @@index([status])
}

// ───── CMS ─────

// Free-form structured content keyed by slug ("about", "hero", "footer").
// `content` is Json so each key can have its own shape (e.g. about = { body: string }).
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  content   Json
  updatedAt DateTime @updatedAt
}

model Service {
  id           String        @id @default(cuid())
  name         String
  description  String?
  price        Decimal       @db.Decimal(10, 2)
  durationMin  Int
  order        Int           @default(0)
  published    Boolean       @default(true)
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([published, order])
}

model FAQItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  // Category bucket key (e.g. "prep", "care"); see FAQ_CATEGORIES in
  // components/faq/faqData.ts. Nullable — rows without a key fall back to the
  // keyword classifier at render time.
  category  String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryPhoto {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([published, order])
}

// ───── Reviews & testimonials ─────

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

// One customer review of a piercing session and/or specific jewelry
// piece(s). See docs/16-reviews.md for the full feature spec.
//
//   PENDING   → fresh submission (manual admin entry or magic-link)
//   PUBLISHED → admin-approved, visible on /about and per-jewelry pages
//   REJECTED  → admin-rejected, kept for audit trail (never public)
//
// `appointmentId` is nullable: magic-link submissions carry it (verified
// customer badge); admin manual entries don't. `jewelryItems` is m2m so
// a single review can tag multiple pieces from one session.
model Review {
  id             String       @id @default(cuid())
  rating         Int          @default(5) // 1..5 (validated app-side)
  text           String
  authorName     String       // "Анна П." — public display name
  photoUrl       String?      // optional Vercel Blob URL
  status         ReviewStatus @default(PENDING)
  featured       Boolean      @default(false) // surfaces on /about
  moderatorNotes String?

  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  appointmentId String?

  jewelryItems Jewelry[] @relation("JewelryReviews")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@unique([appointmentId])
  @@index([status])
  @@index([featured])
}

// ───── Settings (singleton) ─────

model Settings {
  id               String  @id @default("default")
  contactEmail     String?
  contactPhone     String?
  contactAddress  String?
  instagramUrl     String?
  telegramUrl      String?
  telegramChatId   String?
  workingHoursHint String?
}

// ───── Rate limiting ─────

// Fixed-window rate-limit counters. One row per (key, window-start); the id is
// "<key>:<windowStartMs>". lib/rate-limit.ts upserts and atomically increments
// `count`; expired rows are pruned by the expire-reservations cron. Backs the
// throttles on public login / booking / review-submit.
model RateLimit {
  id        String   @id
  count     Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
